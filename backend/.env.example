# Copy to .env (or export) before deploying. See app/config.py + app/security.py.
APP_ENV=production                 # production refuses to start on insecure defaults
ADMIN_USERNAME=officer
ADMIN_PASSWORD=change-me-to-a-long-random-value
CORS_ORIGINS=https://screening.example.gov.in
BEHIND_TLS_PROXY=true              # enables HSTS; only set when deploy/Caddyfile (or equivalent) terminates TLS
ML_SERVICE_URL=http://127.0.0.1:8001
# Optional: Postgres instead of SQLite (see deploy/docker-compose.postgres.yml)
# DATABASE_URL=postgresql+asyncpg://screening:screening@127.0.0.1:5432/screening
